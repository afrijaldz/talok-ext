// Web version: dist/ (built by ./build-web.sh) served as static assets, no Worker code.
{
  "name": "talok-reader",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    // /owner/repo/... has no file of its own: serve index.html and let the reader route it.
    "not_found_handling": "single-page-application",
    // Serve /token.html as is: a redirect to /token would make the service worker cache the
    // guide as the app shell.
    "html_handling": "none"
  },
  "routes": [{ "pattern": "reader.afrijal.dev", "custom_domain": true }]
}
